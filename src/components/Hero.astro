---
// The giant headline is real text for screen readers; the letter-by-letter copy
// next to it is aria-hidden so single letters can roll (src/scripts/headline.js).
// The beach is decoration drawn by src/scripts/beach.js (aria-hidden).

const words = ['Websites', 'Automations'];

// What the man on the beach thinks about. One is shown at random every so often,
// or when someone taps him. Keep them short, true to Dan, and free of claims.
const thoughts = [
  'Why is this webhook firing twice…',
  'Could a bot answer that?',
  'That spreadsheet should update itself.',
  'One more test, then a swim.',
  'Did the deploy go through?',
  'Who still copies invoices by hand?',
  'It works on my machine.',
  'Need more coffee.',
  'Bug, or feature?',
  'Automate it once. Never again.',
  'Where is that missing comma…',
  'The tide is in. So are the emails.',
];
---

<section class="hero">
  <div class="mega-wrap">
    <h1 class="mega">
      <span class="sr-only">Websites and automations</span>
      <span class="mega-art" aria-hidden="true">
        <span class="mega-word" data-roll>{[...words[0]].map((c) => <span class="ch"><span>{c}</span></span>)}</span>
        <svg class="star" viewBox="0 0 24 24" focusable="false"><path fill="currentColor" d="M12 0c.8 6.6 4.9 10.7 12 12-7.1 1.3-11.2 5.4-12 12-.8-6.6-4.9-10.7-12-12C7.1 10.7 11.2 6.6 12 0z"/></svg>
        <span class="mega-word" data-roll>{[...words[1]].map((c) => <span class="ch"><span>{c}</span></span>)}</span>
      </span>
    </h1>
  </div>

  <div class="chart">
    <canvas class="beach" aria-hidden="true"></canvas>
    <p class="chart-clock" data-clock hidden>
      <span class="mono">Palawan</span>
      <time data-palawan-time></time>
    </p>
    <p class="thought" aria-hidden="true"></p>
    <ul hidden data-thoughts>{thoughts.map((t) => <li>{t}</li>)}</ul>
    <p class="mono chart-tag">El Nido &middot; 11°10′50″N 119°23′22″E</p>
  </div>

  <div class="cells cols-hero">
    <div class="hero-copy">
      <p class="statement">Less busywork. More business.</p>
    </div>
    <div>
      <p class="hero-lede">
        I'm Dan. I build automations, AI tools and websites that give business
        owners and teams their time back.
      </p>
      <p class="hero-actions">
        <a class="button" href="#work">See my work</a>
        <a class="text-link" href="#contact">Let's talk</a>
      </p>
    </div>
  </div>
</section>

<script>
  import '../scripts/headline.js';
  import '../scripts/beach.js';
</script>
